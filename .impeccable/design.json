  "narrative": {
    "northStar": "Không gian ứng dụng iOS BDSG",
    "overview": "Chủ quản chọn thay toàn bộ diện mạo sang phong cách iOS ngày 17/11/2026.\nBề mặt sáng, chữ hệ thống, hành động xanh và biểu tượng vuông bo góc tạo\nkhông gian mở ứng dụng, làm việc rồi quay lại. Tên, biểu tượng và tiếng Việt\nvẫn thuộc BDSG; không dùng tài sản Apple.\n\nTài liệu ghi nhận mã ngày 17/11/2026: `ios.css` là stylesheet nạp cuối của\n`index.html`, ghi đè các lớp cũ; trình duyệt riêng dùng `trinh-duyet.css`.\nĐây là kết quả quét nguồn, không phải xác nhận kiểm thử hình ảnh hay triển\nkhai. Bố cục từng ứng dụng giữ nhu cầu nghiệp vụ; vỏ webOS là ngữ cảnh chung.",
    "keyCharacteristics": [
      "Hành động xanh và chữ tối trên bề mặt sáng.",
      "Chữ hệ thống dùng cho tiêu đề, nội dung và điều khiển.",
      "Nhóm nội dung bo góc; Dock và cửa sổ có chiều sâu nhẹ.",
      "Focus bàn phím rõ, có tùy chỉnh chữ lớn và giảm chuyển động."
    ],
    "rules": [
      {
        "name": "The Hành động xanh Rule",
        "body": "Hành động chính dùng màu `primary`; màu biểu tượng chỉ giúp nhận diện ứng dụng. Không lấy nút đen ở stylesheet cũ làm chuẩn.",
        "section": "colors"
      },
      {
        "name": "The Lớp nổi có vai trò Rule",
        "body": "Dùng chiều sâu cho Dock, cửa sổ và thông báo; nhóm danh sách thường chỉ cần nền và đường phân cách.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do giữ nhận diện BDSG, tiếng Việt và lựa chọn phong cách iOS mới nhất.",
      "Do dùng hành động xanh, chữ tối và nhóm bề mặt sáng theo token.",
      "Do giữ focus, tên trợ năng, phản hồi lỗi và hỗ trợ giảm chuyển động.",
      "Do kiểm cả điện thoại, máy tính, chữ lớn và trạng thái rỗng trước nghiệm thu."
    ],
    "donts": [
      "Don't khôi phục nút đen và tiêu đề Lora từ stylesheet đã bị ghi đè.",
      "Don't dùng tài sản Apple hoặc bịa pin, thời tiết, tín hiệu hay trạng thái kết nối.",
      "Don't mô tả liên kết web như SSO, đồng bộ hoặc ứng dụng native đã cài.",
      "Don't coi việc ghi tài liệu từ mã là bằng chứng giao diện đã qua kiểm thử hình ảnh."
    ]
  }
