[Unit]
Description=BDSG encrypted offsite backup with full readback
Wants=network-online.target
After=network-online.target bdsg-backup.service
ConditionPathExists=/etc/bdsg-thanhhoa-backup/oauth-ready

[Service]
Type=oneshot
User=root
Group=bdsg-thanhhoa
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TMPDIR=/var/backups/bdsg-thanhhoa/offsite-staging
ExecStart=/usr/bin/flock -n /var/backups/bdsg-thanhhoa/offsite-staging/.lock /usr/bin/python3 -B /srv/bdsg-thanhhoa/open-bdsg/current/source/trien-khai/van-hanh/v28_offsite_dinh_ky.py
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/var/backups/bdsg-thanhhoa /tmp /var/tmp
ReadWritePaths=/var/backups/bdsg-thanhhoa/offsite-staging /etc/bdsg-thanhhoa-backup /var/lib/bdsg-thanhhoa-status
InaccessiblePaths=/var/lib/bdsg-thanhhoa /etc/bdsg-thanhhoa
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=900
KillMode=control-group
LimitCORE=0
